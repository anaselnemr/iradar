# virtual environment
.venv/

# runtime data: database, snapshots, screenshots, change artifacts
data/

# python
__pycache__/
*.pyc

# QA run logs (the tooling is tracked, its output is not)
qa/*.jsonl
qa/*.log

cloudflared.exe
tests/fixtures/*.html
tunnel.log

# runtime logs (app stdout/stderr, cloudflare tunnel)
*.log

# migration archive: ~1 GB of data, never belongs in git
iradar-*.tar.gz


# local tooling config (editor / agent), never product code
.claude/

# Database backups: hundreds of MB, and they carry every account and its
# password hash. Never in a repo - the Infineon mirror is readable by the team.
local/backups/
